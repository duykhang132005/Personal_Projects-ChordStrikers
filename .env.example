# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your_random_secret_key_here

# Bootstrap admins (create-if-missing ONLY; never resets existing passwords).
# Format: username:password,username2:password2
# Leave empty on production after accounts already exist.
# BOOTSTRAP_ADMINS=admin:change-me,duykhang132005:change-me

# Optional: username that receives unowned sheets (defaults to first BOOTSTRAP_ADMINS user)
# PRIMARY_AUTHOR=duykhang132005

# Required in production. The app refuses to start without it.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Local development only: allow a throwaway key when SECRET_KEY is unset.
# ALLOW_INSECURE_DEV_KEY=1
